# ────────────────────────────────────────────────
# The Interrogation Room — environment variables
# Copy to .env (repo root) and fill in.
# ────────────────────────────────────────────────

# LiveKit Cloud — sign up at https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram — sign up at https://deepgram.com
DEEPGRAM_API_KEY=

# ElevenLabs — sign up at https://elevenlabs.io
ELEVENLABS_API_KEY=
# Pick a voice in the ElevenLabs library and paste its voice_id here.
# Recommended: a male, mid-range, slightly clipped voice for Victor Crane.
ELEVENLABS_VOICE_ID=

# NVIDIA NIM — sign up at https://build.nvidia.com (free for prototyping)
# API keys start with "nvapi-"
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=moonshotai/kimi-k2.5

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
